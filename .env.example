# ---------------------------------------------------------------------------
# Everything here has a working default. The service runs with an empty .env:
# embedded Qdrant on disk, and a deterministic stub in place of the LLMs.
# ---------------------------------------------------------------------------

# --- LLM (dual-model) ------------------------------------------------------
# Provider for BOTH slots: anthropic | openai | openrouter | gemini | stub
# With no key for the chosen provider, the service falls back to `stub`
# rather than failing at request time.
LLM_PROVIDER=anthropic

# Fast model. Runs the planner on every turn: decomposition + structured output.
PLANNER_MODEL=claude-haiku-4-5
# Strong model. Runs once, on grounded synthesis only.
SYNTHESIZER_MODEL=claude-opus-5

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Gemini pairing:     PLANNER_MODEL=gemini-2.0-flash   SYNTHESIZER_MODEL=gemini-2.5-pro
# OpenAI pairing:     PLANNER_MODEL=gpt-4o-mini        SYNTHESIZER_MODEL=gpt-4o

# --- Vector store ----------------------------------------------------------
# Leave QDRANT_URL empty to use the embedded on-disk Qdrant at data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION=financial_statements

# --- Retrieval -------------------------------------------------------------
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
TOP_K=10
RRF_K=60
CANDIDATES_PER_BRANCH=40
MAX_SUBQUERIES=6

# --- Entity resolution -----------------------------------------------------
# RapidFuzz score floor, and the margin a match must beat the runner-up by
# before it is allowed to become a strict filter.
FUZZY_THRESHOLD=84
FUZZY_MARGIN=6

# --- Turn budget -----------------------------------------------------------
MAX_TURNS=3
GLOBAL_DEADLINE_S=25
TURN_DEADLINE_S=8
LLM_TIMEOUT_S=20
COVERAGE_TARGET=0.85

# --- Data pipeline ---------------------------------------------------------
# SEC asks for a descriptive User-Agent with contact details.
SEC_USER_AGENT=your-project-name your.email@example.com

LOG_LEVEL=INFO
